{
      "name": "Acervo Digital",
      "version": "2.1.0",
      "private": true,
      "engines": {
            "node": "24.x"
      },
      "dependencies": {
            "@supabase/supabase-js": "^2.119.0",
            "intro.js": "^8.6.0",
            "lucide-react": "^0.487.0",
            "react": "^18.3.1",
            "react-dom": "^18.3.1"
      },
      "devDependencies": {
            "@types/node": "^24.19.2",
            "@types/react": "^18.3.31",
            "@types/react-dom": "^18.3.7",
            "@vitejs/plugin-react-swc": "^4.3.3",
            "jsdom": "^30.1.3",
            "typescript": "~5.9",
            "vite": "^8.3.5",
            "vitest": "^5.1.0"
      },
      "scripts": {
            "dev": "vite",
            "build": "vite build",
            "server:dev": "cd server && npm run dev",
            "server:build": "cd server && npm run build",
            "server:start": "cd server && npm start",
            "prisma:generate": "cd server && npx prisma generate",
            "prisma:migrate": "cd server && npm run prisma:migrate:deploy",
            "prisma:studio": "cd server && npx prisma studio",
            "db:up": "docker compose up -d postgres",
            "db:reset": "docker compose down -v && docker compose up -d postgres",
            "docker:down": "docker compose down",
            "seed": "cd server && npm run seed",
            "setup": "npm run db:up && npm run prisma:generate && npm run prisma:migrate && npm run seed",
            "import:categorizacao": "cd server && npm run import:categorizacao",
            "import:categorizacao:com-capa": "cd server && npm run import:categorizacao:com-capa",
            "diff:planilha": "cd server && npm run diff:planilha --",
            "planilha:preparar": "cd server && npm run planilha:preparar --",
            "db:exportar": "cd server && npm run db:exportar",
            "relatorio:nde": "cd server && npm run relatorio:nde",
            "db:descartar": "cd server && npm run db:descartar",
            "thumbs:setup": "cd server && npm run thumbs:setup",
            "thumbs:capture": "cd server && npm run thumbs:capture --",
            "test": "vitest run",
            "typecheck": "tsc --noEmit -p ."
      }
}
