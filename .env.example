# Copie para .env na raiz (não versionado). Serve ao site (Vite) e ao docker compose.
# A API, quando roda fora do container, lê o server/.env (veja server/.env.example).

# Alvo do site. ec2 = API Express (local e container). supabase = Auth/REST do Supabase,
# que é a produção na Vercel.
VITE_BACKEND=ec2
# No npm run dev, o Vite encaminha /api para a API em localhost:3001.
VITE_API_URL=/api
# VITE_SUPABASE_URL=https://iezvzcrmzdfljvbbdneu.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
# Nunca cole a secret (sb_secret_...) no Vercel nem neste arquivo.
# GitHub Actions (keep-supabase-awake.yml): secrets SUPABASE_URL e SUPABASE_ANON_KEY iguais às VITE_.

# Postgres do docker compose (npm run db:up e npm run app:up).
POSTGRES_USER=acervo
POSTGRES_PASSWORD=acervo
POSTGRES_DB=acervo
POSTGRES_PORT=5433

# Acervo inteiro em container (npm run app:up). Sem JWT_SECRET a API não sobe.
# Gere, por exemplo, com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Endereço do site: http://localhost:8080
WEB_PORT=8080
# true para não recarregar usuários de demonstração e catálogo a cada subida.
SKIP_SEED=false
