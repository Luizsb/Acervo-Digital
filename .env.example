# Copie para .env na raiz (não versionado) antes do docker compose.
# Local: valores abaixo bastam. EC2: troque senhas, JWT e bind da porta 80.

POSTGRES_USER=acervo
POSTGRES_PASSWORD=acervo
POSTGRES_DB=acervo

JWT_SECRET=substitua-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# O nginx do frontend encaminha /api para a API. Não use localhost:3001 no browser.
VITE_API_URL=/api
CORS_ORIGIN=http://localhost:3000

# Local: 127.0.0.1 e 3000. EC2: 0.0.0.0 e 80.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# true nas subidas seguintes se o catálogo já estiver no volume do Postgres
SKIP_SEED=false

# Cadastro público (deixe false até o JumpCloud)
ENABLE_REGISTRATION=false

# true quando a API está atrás do nginx
TRUST_PROXY=true
