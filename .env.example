# Copie para .env na raiz (não versionado) antes do docker compose.
# Local: valores abaixo bastam. EC2: troque senhas, JWT e bind da porta 80.

POSTGRES_USER=acervo
POSTGRES_PASSWORD=acervo
POSTGRES_DB=acervo

JWT_SECRET=substitua-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# O nginx do frontend encaminha /api para a API. Não use localhost:3001 no browser.
VITE_API_URL=/api
CORS_ORIGIN=http://localhost:3000

# Local: 127.0.0.1 e 3000. Na EC2 mantenha assim: quem atende a internet é o Caddy.
WEB_BIND=127.0.0.1
WEB_PORT=3000

# HTTPS automático na EC2. Sem estas duas linhas o Caddy não sobe e tudo segue em HTTP.
# O hostname precisa resolver para o IP da instância; sslip.io faz isso sem cadastro.
# COMPOSE_PROFILES=https
# ACERVO_HOSTNAME=13-217-4-132.sslip.io

# true nas subidas seguintes se o catálogo já estiver no volume do Postgres
SKIP_SEED=false

# Cadastro público (deixe false até o JumpCloud)
ENABLE_REGISTRATION=false

# Número de proxies na frente da API: 1 só com o nginx, 2 com o Caddy também.
# Errar esse número faz o limitador de login bloquear todos os usuários juntos.
TRUST_PROXY=1

# Token para o Google Apps Script (ou outro cron) enviar a planilha diariamente.
# Gere com: openssl rand -hex 32
# SPREADSHEET_SYNC_TOKEN=

# Captura as capas que faltam logo após a sincronização automática.
# Use false para deixar a captura só sob demanda no painel admin.
AUTO_CAPTURE_THUMBS_AFTER_SYNC=true
AUTO_CAPTURE_THUMBS_LIMIT=50

# Configuração opcional para integrações diretas com Google Sheets.
GOOGLE_SHEETS_ID=1fAQaH8oG1UH8GMfN2xlqWULKVJ2EYvf3JGxYD2o00yk
# GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/1fAQaH8oG1UH8GMfN2xlqWULKVJ2EYvf3JGxYD2o00yk/edit

# Se a planilha for privada, compartilhe com o e-mail da conta de serviço (Leitor)
# e preencha uma das opções abaixo:
# GOOGLE_SERVICE_ACCOUNT_JSON=/caminho/para/service-account.json
# GOOGLE_SERVICE_ACCOUNT_EMAIL=acervo-sync@projeto.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
