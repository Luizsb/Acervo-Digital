# Banco de dados
# Local (Docker): docker compose up -d
DATABASE_URL="postgresql://acervo:acervo@localhost:5433/acervo"
DIRECT_URL="postgresql://acervo:acervo@localhost:5433/acervo"

# Supabase (import e migrate na sua máquina). Substitua [SENHA]. Não commite este arquivo.
# DATABASE_URL="postgresql://postgres.iezvzcrmzdfljvbbdneu:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# DIRECT_URL="postgresql://postgres.iezvzcrmzdfljvbbdneu:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require"

PORT=3001
CORS_ORIGIN=http://localhost:3000
# Obrigatório em produção. Gere, por exemplo, com: openssl rand -base64 48
JWT_SECRET=substitua-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d
ENABLE_REGISTRATION=false
TRUST_PROXY=false

# Opcional: token para o Google Apps Script (ou outro cron) enviar a planilha.
# Gere com: openssl rand -hex 32
# SPREADSHEET_SYNC_TOKEN=

# Captura as capas que faltam logo após a sincronização automática.
# AUTO_CAPTURE_THUMBS_AFTER_SYNC=true
# AUTO_CAPTURE_THUMBS_LIMIT=50

# Opcional: integração direta com o Google Sheets.
# GOOGLE_SHEETS_ID=1fAQaH8oG1UH8GMfN2xlqWULKVJ2EYvf3JGxYD2o00yk
# Se a planilha for privada, compartilhe com o e-mail da conta de serviço (Leitor):
# GOOGLE_SERVICE_ACCOUNT_JSON=/caminho/para/service-account.json
# GOOGLE_SERVICE_ACCOUNT_EMAIL=acervo-sync@projeto.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
