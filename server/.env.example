# Banco de dados
# Local (Docker): docker compose up -d
DATABASE_URL="postgresql://acervo:acervo@localhost:5433/acervo"
DIRECT_URL="postgresql://acervo:acervo@localhost:5433/acervo"

# Supabase (import e migrate na sua máquina). Substitua [SENHA]. Não commite este arquivo.
# DATABASE_URL="postgresql://postgres.iezvzcrmzdfljvbbdneu:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.iezvzcrmzdfljvbbdneu:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

PORT=3001
CORS_ORIGIN=http://localhost:3000
# Obrigatório em produção. Gere, por exemplo, com: openssl rand -base64 48
JWT_SECRET=substitua-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=7d
ENABLE_REGISTRATION=false
TRUST_PROXY=false
